# ForgeRace + когнитивные фреймы
# Скопируй в корень проекта как forgerace.toml

[project]
name = "my-project"
context = "описание проекта — что это, на чём написано"
discuss_context = "контекст для дискуссий — домен, ограничения, что важно"
root = "."
dev_branch = "develop"
discuss_dir = "docs/discuss"

# ── Когнитивные фреймы ──────────────────────────────────────
# /agent+frame в дискуссиях. Три qwen с разными фреймами = три специалиста за $0
# Сценарий: /qwen+audit → /qwen+wild → /qwen+price (проверь → сломай → оцени цену)

[frames.audit]
description = "8 осей выживаемости решения"
file = "frames/audit.md"

[frames.wild]
description = "дикие стратегии, инверсия, слом шаблонов"
file = "frames/wild.md"

[frames.price]
description = "цена выбора, trade-off матрицы, арбитраж"
file = "frames/price.md"

[frames.theory]
description = "от принципов к реализации"
file = "frames/theory.md"

[frames.evidence]
description = "от фактов к обобщению"
file = "frames/evidence.md"

[frames.optimizer]
description = "4-фазный разбор: grounding → divergence → red-teaming"
file = "frames/optimizer.md"

[frames.meta]
description = "13 фреймворков: диалектика, теория игр, стоицизм..."
file = "frames/meta.md"

[frames.vectors]
description = "10 когнитивных векторов: дедукция, инверсия, парадокс..."
file = "frames/vectors.md"

# ── Агенты ───────────────────────────────────────────────────
# Включи то что установлено. Фреймы работают с любой моделью.

[agents.qwen]
enabled = true
command = "qwen"
args = ["-p", "--allowed-tools", "read_file,write_file,edit,run_shell_command,grep_search,glob,list_directory,web_fetch",
        "--output-format", "stream-json", "--approval-mode", "yolo"]
review_args = ["-p", "--output-format", "text", "--approval-mode", "yolo"]
inactivity_timeout = 300

[agents.gemini]
enabled = false  # включи если есть
command = "gemini"
args = ["-p", "--approval-mode", "yolo", "--output-format", "stream-json"]
review_args = ["-p", "-"]
inactivity_timeout = 180

[agents.claude]
enabled = false  # включи если есть
command = "claude"
args = ["-p", "--allowedTools", "Read,Write,Edit,Bash,Grep,Glob", "--max-turns", "50", "--output-format", "stream-json", "--verbose"]
review_args = ["-p", "-", "--output-format", "text", "--permission-mode", "auto"]
inactivity_timeout = 300

# ── Сборка ───────────────────────────────────────────────────

[build]
commands = []
check_command = ""
timeout = 120

[limits]
agent_timeout = 900
max_review_rounds = 3

[rules]
agent_rules = """
ЗАПРЕЩЕНО:
- git stash, git checkout, git reset, git clean
- Изменение .env, credentials, secrets

ПРАВИЛА:
1. Трогай ТОЛЬКО файлы из секции "Файлы" задачи.
2. Используй паттерны из существующего кода.
3. НИКОГДА не удаляй код, не относящийся к задаче.
"""
